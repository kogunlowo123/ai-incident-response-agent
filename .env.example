# Copy to .env and adjust. Every variable is optional.

# Storage and context files
SOCAGENT_DB_PATH=.socagent/socagent.db
# SOCAGENT_ASSETS_FILE=configs/assets.example.yaml
# SOCAGENT_IOCS_FILE=configs/iocs.example.json
# SOCAGENT_POLICY_FILE=configs/policy.example.yaml

# Response execution
# dry_run records what would happen and touches nothing. live posts approved actions to your
# SOAR or automation webhook, which then performs them. live requires SOCAGENT_CONNECTOR_URL.
SOCAGENT_EXECUTION_MODE=dry_run
# SOCAGENT_CONNECTOR_URL=https://soar.example.com/hooks/your-token

# Ingestion limits
SOCAGENT_MAX_LINE_BYTES=200000
SOCAGENT_MAX_LINES=1000000

# Optional model-written incident summaries
# llm_provider: none | openai | anthropic. The model only sees aggregate counts, never entity names.
SOCAGENT_LLM_PROVIDER=none
# SOCAGENT_OPENAI_API_KEY=
SOCAGENT_OPENAI_BASE_URL=https://api.openai.com/v1
SOCAGENT_OPENAI_CHAT_MODEL=gpt-4o-mini
# SOCAGENT_ANTHROPIC_API_KEY=
SOCAGENT_ANTHROPIC_BASE_URL=https://api.anthropic.com
SOCAGENT_ANTHROPIC_MODEL=claude-sonnet-5
SOCAGENT_ANTHROPIC_MAX_TOKENS=500

# HTTP and logging
SOCAGENT_HTTP_TIMEOUT_SECONDS=30
SOCAGENT_RETRY_ATTEMPTS=3
SOCAGENT_RETRY_MIN_WAIT=0.5
SOCAGENT_RETRY_MAX_WAIT=8
SOCAGENT_LOG_LEVEL=WARNING
SOCAGENT_LOG_JSON=true
